* text=auto eol=lf

*.blade.php diff=html
*.css diff=css
*.html diff=html
*.md diff=markdown
*.php diff=php

/.github export-ignore
CHANGELOG.md export-ignore
.styleci.yml export-ignore

# Excluir plantillas de impresión PDF y reportes generados de las estadísticas de GitHub Linguist
resources/views/pdf/** linguist-generated=true
resources/views/components/pdf/** linguist-generated=true
qa/informes/generados/** linguist-generated=true
public/openapi.json linguist-generated=true
